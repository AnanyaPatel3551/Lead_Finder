# Copy this file to .env and fill in your own keys. Never commit .env.

# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=

# Tavily free plan (1,000 searches/month): https://app.tavily.com
TAVILY_API_KEY=

# OpenAI-compatible endpoint; switching provider means changing these two lines only
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=
